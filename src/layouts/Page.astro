---
import Base from './Base.astro';
interface Props { title: string; description?: string; lede?: string; wide?: boolean }
const { title, description, lede, wide = false } = Astro.props;
---

<Base title={title} description={description ?? lede}>
  <div class:list={['container', 'page', { narrow: !wide }]}>
    <header>
      <h1>{title}</h1>
      {lede && <p class="lede">{lede}</p>}
    </header>
    <slot />
  </div>
</Base>

<style>
  .page {
    padding-top: 3.5rem;
  }
  header {
    margin-bottom: 2.5rem;
  }
  h1 {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(2rem, 5vw, 2.8rem);
    letter-spacing: -0.02em;
    line-height: 1.15;
  }
  .lede {
    margin: 0.75rem 0 0;
    font-family: var(--font-serif);
    font-size: 1.25rem;
    color: var(--muted);
  }
</style>
