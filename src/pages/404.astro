---
import Base from '../layouts/Base.astro';
import { url } from '../lib/posts';
---

<Base title="Page not found">
  <div class="container nf">
    <p class="code">404</p>
    <h1>This page wandered off.</h1>
    <p class="muted">The page you're looking for doesn't exist or has moved.</p>
    <p><a href={url('/')}>Back to all writing →</a> &nbsp; <a href={url('/search/')}>Search</a></p>
  </div>
</Base>

<style>
  .nf { text-align: center; padding-top: 6rem; }
  .code { font-family: var(--font-display); font-size: 6rem; font-weight: 700; margin: 0; color: var(--accent); line-height: 1; }
  h1 { font-family: var(--font-display); font-weight: 600; margin: 1rem 0 0.5rem; }
</style>
